# ─── Base de datos ────────────────────────────────────────────
DB_USER=cms_user
DB_PASSWORD=cms_pass

# ─── JWT ──────────────────────────────────────────────────────
# Mínimo 256 bits — generá uno con: openssl rand -base64 64
JWT_SECRET=reemplaza-este-valor-con-una-clave-segura-de-al-menos-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_DAYS=7

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ─── YouTube Data API v3 ──────────────────────────────────────
YOUTUBE_API_KEY=tu-youtube-api-key

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
